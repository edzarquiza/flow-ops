<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>FlowOps.Application</RootNamespace>
    <AssemblyName>FlowOps.Application</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Layered architecture per ADR-0002: Application references Infrastructure directly
      (injects FlowOpsDbContext) — no IRepository<T>/IUnitOfWork seam. No PackageReference of
      its own yet: Phase 3A is structural only, no use cases implemented.
    -->
    <ProjectReference Include="..\FlowOps.Domain\FlowOps.Domain.csproj" />
    <ProjectReference Include="..\FlowOps.Infrastructure\FlowOps.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Phase 19 (ADR-0018): CurrentUserAccessor needs IHttpContextAccessor and
      IDataProtectionProvider, both part of the ASP.NET Core shared framework rather than a
      standalone NuGet package. This project stays a plain class library (not
      Microsoft.NET.Sdk.Web — it has no web pipeline of its own); a FrameworkReference is the
      standard, Microsoft-documented way for a library to use shared-framework APIs without
      becoming a web app itself, the same shape Infrastructure already uses for Identity.
    -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned to match FlowOps.Infrastructure exactly — see the note there. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

</Project>
