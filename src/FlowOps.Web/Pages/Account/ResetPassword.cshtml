@page
@model FlowOps.Web.Pages.Account.ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}
<div class="login-shell">
    <div class="login-brand">
        @Html.Raw(FlowOps.Web.Icons.BrandMark(40))
        <div class="login-wordmark">FlowOps</div>
        <p class="login-tagline">Set a new password.</p>
    </div>

    <div class="login-card">
        <h1>Reset password</h1>
        @if (Model.Succeeded)
        {
            await Html.RenderPartialAsync("_Notice", new FlowOps.Web.NoticeViewModel("Your password has been reset."));
            <p><a class="btn-primary login-submit" asp-page="/Account/Login">Continue to sign in &rarr;</a></p>
        }
        else
        {
            <p class="ticket-subtitle">Choose a new password for your FlowOps account.</p>
            <div class="validation-summary-errors" asp-validation-summary="All" role="alert"></div>
            <form method="post" asp-route-userId="@Model.UserId" asp-route-token="@Model.Token">
                @Html.AntiForgeryToken()
                <div class="field">
                    <label asp-for="Input.NewPassword">New password</label>
                    <input asp-for="Input.NewPassword" autocomplete="new-password" aria-describedby="new-password-error" />
                    <span id="new-password-error" class="field-validation-error" asp-validation-for="Input.NewPassword"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.ConfirmPassword">Confirm new password</label>
                    <input asp-for="Input.ConfirmPassword" autocomplete="new-password" aria-describedby="confirm-password-error" />
                    <span id="confirm-password-error" class="field-validation-error" asp-validation-for="Input.ConfirmPassword"></span>
                </div>
                <button type="submit" class="btn-primary login-submit">Reset password</button>
            </form>
        }
        <p><a class="text-link" asp-page="/Account/Login">Back to sign in</a></p>
    </div>
</div>
