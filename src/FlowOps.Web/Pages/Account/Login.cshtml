@page
@model FlowOps.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<div class="login-shell">
    <div class="login-brand">
        @* The same FlowOps mark used in the app header (_Layout.cshtml) — a ring with one wave
           crossing it, the brand's own visual metaphor. Not a separate asset: reused verbatim from
           FlowOps.Web.Icons so Login and the authenticated app share one identity. *@
        @Html.Raw(FlowOps.Web.Icons.BrandMark(40))
        <div class="login-wordmark">FlowOps</div>
        <p class="login-tagline">Operations in flow.</p>
    </div>

    <div class="login-card">
        <h1>Sign in</h1>
        <div class="validation-summary-errors" asp-validation-summary="All" role="alert"></div>
        <form method="post">
            @Html.AntiForgeryToken()
            <div class="field">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" autocomplete="username" aria-describedby="email-error" />
                <span id="email-error" class="field-validation-error" asp-validation-for="Input.Email"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" autocomplete="current-password" aria-describedby="password-error" />
                <span id="password-error" class="field-validation-error" asp-validation-for="Input.Password"></span>
            </div>
            <button type="submit" class="btn-primary login-submit">Sign in</button>
        </form>
        @* ADR-0027: no self-service reset exists — FlowOps sends no email at all, so there is no
           "email yourself a reset link" flow to offer. An Admin generates a one-time reset link
           from Organization/Members and sends it out-of-band instead. *@
        <p class="ticket-subtitle">Forgot your password? Ask your organization admin for a reset link.</p>
        <p><a class="text-link" asp-page="/Account/Register">Create an account</a></p>
    </div>

    @if (Model.DemoEnabled)
    {
        @* CLAUDE.md §14: "credentials supplied via environment variables, displayed on the login
           page, never in git." Model.DemoPersonaPassword is read from configuration at request
           time — nothing here is a literal in source. Visually secondary to the form above: a
           smaller heading, a quieter surface, and no changes to what data is shown. *@
        <section class="demo-access" aria-label="Public demo credentials">
            <h2>Demo access</h2>
            <p>This is a portfolio demonstration running on synthetic data. Sign in as any persona
               below using the shared demo password.</p>
            @* Bug fix: this used to be a 4-column table (Persona/Email/Role/Shows) wide enough to
               force horizontal scrolling once the "Shows" description was included — a card per
               persona wraps and stacks at any width instead, with nothing to scroll sideways to
               see. Same data, same wording, no credential changed. *@
            <div class="demo-personas">
                @foreach (var persona in Model.DemoPersonas)
                {
                    <div class="demo-persona-card">
                        <div class="demo-persona-card__header">
                            <span class="demo-persona-card__name">@persona.DisplayName</span>
                            <span class="demo-persona-card__role">@persona.Role</span>
                        </div>
                        <dl class="demo-persona-card__detail">
                            <dt>Email</dt>
                            <dd><code>@persona.Email</code></dd>
                        </dl>
                        <p class="demo-persona-card__shows">@persona.Shows</p>
                    </div>
                }
            </div>
            <p class="demo-password">Password (all personas): <code>@Model.DemoPersonaPassword</code></p>
        </section>
    }
</div>
