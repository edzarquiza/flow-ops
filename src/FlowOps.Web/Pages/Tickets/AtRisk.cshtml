@page
@using FlowOps.Application.Tickets
@using FlowOps.Domain.Attention
@using FlowOps.Domain.Tickets
@model FlowOps.Web.Pages.Tickets.AtRiskModel
@{
    ViewData["Title"] = "At-risk work";
}
<div class="validation-summary-errors" asp-validation-summary="ModelOnly" role="alert"></div>
<div class="page-header">
    <div class="page-header__top">
        <div class="section-head section-head--plain">
            <div class="page-header__title-row">
                <h1>At-risk work</h1>
                <div class="page-header__metric">
                    <span class="page-header__metric-value">@Model.Queue.TotalCount</span>
                    <span class="page-header__metric-label">need@(Model.Queue.TotalCount == 1 ? "s" : "") attention</span>
                </div>
            </div>
            <p class="page-context">Work requiring operational attention, ranked most urgent first.</p>
        </div>
        @await Html.PartialAsync("_SearchBox", new FlowOps.Web.SearchBoxViewModel("Search at-risk work...", Model.Search))
    </div>
    <p class="page-actions">
        <a class="back-link" asp-page="/Tickets/Index">&larr; Work queue</a>
        <a class="guide-help-link" asp-page="/Guide/SlaAndAttention">How is attention determined?</a>
    </p>
</div>

@* Phase 25 §16: narrower than the Work Queue's date filter by design — one quick-range selector,
   always narrowing by SLA due date (the field genuinely relevant to an intelligence/attention
   view), no field choice. See AttentionQueryService.GetAtRiskAsync's own doc comment. *@
<form method="get" class="filter-bar" aria-label="Date filter" data-autosubmit>
    <input type="hidden" name="search" value="@Model.Search" />
    <div class="filter-bar__field">
        <label for="range">Due within</label>
        <select id="range" name="range">
            <option value="@DateRangeOption.AllTime" selected="@(Model.DateRangeOption == DateRangeOption.AllTime)">Any time</option>
            <option value="@DateRangeOption.Today" selected="@(Model.DateRangeOption == DateRangeOption.Today)">Today</option>
            <option value="@DateRangeOption.ThisWeek" selected="@(Model.DateRangeOption == DateRangeOption.ThisWeek)">This week</option>
            <option value="@DateRangeOption.ThisMonth" selected="@(Model.DateRangeOption == DateRangeOption.ThisMonth)">This month</option>
            <option value="@DateRangeOption.Last7Days" selected="@(Model.DateRangeOption == DateRangeOption.Last7Days)">Last 7 days</option>
            <option value="@DateRangeOption.Last30Days" selected="@(Model.DateRangeOption == DateRangeOption.Last30Days)">Last 30 days</option>
            <option value="@DateRangeOption.Last90Days" selected="@(Model.DateRangeOption == DateRangeOption.Last90Days)">Last 90 days</option>
            <option value="@DateRangeOption.Custom" selected="@(Model.DateRangeOption == DateRangeOption.Custom)">Custom range</option>
        </select>
    </div>
    @if (Model.DateRangeOption == DateRangeOption.Custom)
    {
        <div class="filter-bar__field">
            <label for="from">From</label>
            <input id="from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="filter-bar__field">
            <label for="to">To</label>
            <input id="to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
    }
    <div class="filter-bar__actions">
        <button type="submit" class="btn">Apply</button>
        @if (Model.HasDateFilter)
        {
            <a class="btn" asp-page="/Tickets/AtRisk" asp-route-search="@Model.Search">Clear dates</a>
        }
    </div>
</form>
<script src="~/js/dashboard-filters.js" asp-append-version="true"></script>

@* Visual-consistency pass: the same .panel--focus surface the dashboard's "What needs attention"
   already uses for this exact .q-list/.q-row component. Pagination stays outside the panel
   (navigation chrome, not the list surface itself). *@
@if (Model.Queue.TotalCount == 0)
{
    <div class="panel panel--focus">
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <div class="empty-state">
                <p class="empty-state__title">No tickets found</p>
                <p>No tickets matched "@Model.Search".</p>
                <p><a class="back-link" asp-page="/Tickets/AtRisk">Clear search</a></p>
            </div>
        }
        else
        {
            @* A useful empty state, not a blank panel (CLAUDE.md §22). *@
            <p class="empty-state">
                @(Model.HasDateFilter ? "No work matches the selected date range." : "No work is at risk right now.")
            </p>
        }
    </div>
}
else
{
    var atRiskRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary
    {
        { "search", Model.Search },
        { "range", Model.DateRangeOption.ToString() },
        { "from", Model.From?.ToString("yyyy-MM-dd") },
        { "to", Model.To?.ToString("yyyy-MM-dd") },
    };
    await Html.RenderPartialAsync(
        "_Pagination",
        FlowOps.Web.PaginationViewModel.For(
            "/Tickets/AtRisk",
            Model.Queue,
            atRiskRouteValues,
            "At-risk queue pagination",
            FlowOps.Web.PaginationPlacement.Top));

    @* Phase 11: the same composed-row component Work Queue uses (see .q-row in flowops.css).
       Priority and signal severity are deliberately NOT the same visual treatment here — sharing
       one produced rows that read "LOW ... CRITICAL," genuinely confusing since they're different
       concepts. Signal severity gets the ranked severity badge (.sev); priority stays plain text
       in the metadata line. Only the top-ranked signal (AttentionPolicy's own ranking, ATTN-RULE-04)
       carries colour; the rest fold into the same line at reduced opacity via .why-secondary. *@
    <div class="panel panel--focus">
        <div class="q-list">
            @foreach (var ticket in Model.Queue.Items)
            {
                var slaText = ticket.Sla.Status.ToString();
                var slaClass = slaText == "Breached" ? "is-breached" : slaText == "AtRisk" ? "is-at-risk" : "";
                var topSignal = ticket.Signals[0];
                var topSevClass = topSignal.Severity.ToString().ToLowerInvariant() switch
                {
                    "critical" => "crit",
                    "high" => "high",
                    "medium" => "med",
                    _ => "low",
                };
                <div class="q-row-wrap">
                    <a class="q-row @slaClass" asp-page="/Tickets/Details" asp-route-id="@ticket.Id">
                        <div class="q-main">
                            <div class="q-title">@ticket.Title</div>
                            <div class="q-meta">
                                <span class="q-ref">@ticket.Reference</span><span class="q-dot" aria-hidden="true">&middot;</span>
                                <span>@ticket.TeamName</span><span class="q-dot" aria-hidden="true">&middot;</span>
                                <span>@(ticket.AssigneeDisplayName ?? "Unassigned")</span><span class="q-dot" aria-hidden="true">&middot;</span>
                                <span class="status-badge status-badge--compact @FlowOps.Web.StatusBadgeDisplay.CssClass(ticket.Status)">@FlowOps.Web.WorkflowRail.Label(ticket.Status)</span><span class="q-dot" aria-hidden="true">&middot;</span>
                                <span>Priority: @ticket.Priority</span>
                                @for (var signalIndex = 0; signalIndex < ticket.Signals.Count; signalIndex++)
                                {
                                    <span class="q-dot" aria-hidden="true">&middot;</span>
                                    <span class="@(signalIndex == 0 ? "" : "why-secondary")">@ticket.Signals[signalIndex].Headline</span>
                                }
                            </div>
                        </div>
                        <div class="q-sev-col">
                            <div class="sev @topSevClass"><i aria-hidden="true"></i><span>@topSignal.Severity</span></div>
                        </div>
                        <div class="q-rail-col" aria-hidden="true">
                            @{ await Html.RenderPartialAsync("_WorkflowRail", new FlowOps.Web.RailViewModel(ticket.Status, ticket.Sla)); }
                        </div>
                        <div class="q-sla" title="Deadline @ticket.Sla.DueAt.ToString("u")">
                            <span class="q-sla__state">@FlowOps.Web.SlaDisplay.StatusLabel(ticket.Sla.Status)</span>
                            @if (FlowOps.Web.SlaDisplay.Remaining(ticket.Sla) is { } remaining)
                            {
                                <span class="q-sla__time">@remaining</span>
                            }
                        </div>
                    </a>
                    @* Phase 30: the compact Attention Brief — Signals (repeated here as a clean
                       list, not the inline-joined line above) plus the deterministic Suggested
                       next step. "What changed" is Ticket Detail's own, one click away — not
                       worth an extra per-row history query on a page of up to 25 tickets. *@
                    <details class="attention-disclosure">
                        <summary>View attention brief</summary>
                        <div class="attention-disclosure__body panel">
                            <div class="attention-brief__section">
                                <h3>Signals</h3>
                                <ul class="attention-brief__signals">
                                    @foreach (var signal in ticket.Signals)
                                    {
                                        var signalSevClass = signal.Severity.ToString().ToLowerInvariant() switch
                                        {
                                            "critical" => "crit",
                                            "high" => "high",
                                            _ => "med",
                                        };
                                        <li>
                                            <span class="sev @signalSevClass" aria-hidden="true"><i></i><span>@signal.Severity</span></span>
                                            <span>@signal.Headline</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                            @if (ticket.SuggestedNextStep is { } nextStep)
                            {
                                <div class="attention-brief__section attention-brief__next-step">
                                    <h3>Suggested next step</h3>
                                    <p>@nextStep</p>
                                </div>
                            }
                        </div>
                    </details>
                </div>
            }
        </div>
    </div>

    @await Html.PartialAsync(
        "_Pagination",
        FlowOps.Web.PaginationViewModel.For(
            "/Tickets/AtRisk",
            Model.Queue,
            atRiskRouteValues,
            "At-risk queue pagination"))
}
