@page
@using FlowOps.Domain.Tickets
@model FlowOps.Web.Pages.Tickets.CreateModel
@{
    ViewData["Title"] = "New ticket";
}
<div class="page-header">
    <div class="section-head section-head--plain">
        <h1>New ticket</h1>
        <p class="page-context">Describe the work and route it to the team that owns it.</p>
    </div>
</div>

@if (Model.WorkspaceNotReady)
{
    <div class="zone">
        <p class="empty-state">
            Your workspace isn't ready for tickets yet. Create a team and category before filing a ticket.
        </p>
        @if (Model.CanSetUpWorkspace)
        {
            <p><a class="btn-primary" asp-page="/Admin/Index">Set up a team &rarr;</a></p>
        }
        else
        {
            <p class="page-context">Ask an organization Admin to set up a team and category.</p>
        }
    </div>
    <p><a class="back-link" asp-page="/Tickets/Index">&larr; Back to work queue</a></p>
}
else
{
    @await Html.PartialAsync("_SetupNextStep", Model.NextStep)

    <div class="validation-summary-errors" asp-validation-summary="All" role="alert"></div>

    <form method="post">
        <div class="zone">
            @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("What needs to be done")); }
            <div class="field">
                <label asp-for="Input.Title">Title<span class="field-required" aria-hidden="true">*</span></label>
                <input asp-for="Input.Title" aria-describedby="title-error" />
                <span id="title-error" class="field-validation-error" asp-validation-for="Input.Title"></span>
            </div>
            <div class="field">
                <label asp-for="Input.Description">Description<span class="field-required" aria-hidden="true">*</span></label>
                <textarea asp-for="Input.Description" rows="8" aria-describedby="description-error"></textarea>
                <span id="description-error" class="field-validation-error" asp-validation-for="Input.Description"></span>
            </div>
        </div>

        <div class="zone">
            @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("Where the work belongs")); }
            <div class="field-grid">
                <div class="field">
                    <label asp-for="Input.WorkType">Work type<span class="field-required" aria-hidden="true">*</span></label>
                    <select asp-for="Input.WorkType">
                        @foreach (var workType in Enum.GetValues<WorkType>())
                        {
                            <option value="@workType">@FlowOps.Web.WorkTypeDisplay.ToDisplayName(workType)</option>
                        }
                    </select>
                    <span class="field-validation-error" asp-validation-for="Input.WorkType"></span>
                </div>
                <div class="field">
                    <label asp-for="Input.Priority">Priority<span class="field-required" aria-hidden="true">*</span></label>
                    <select asp-for="Input.Priority" asp-items="Html.GetEnumSelectList<Priority>()"></select>
                    <span class="field-validation-error" asp-validation-for="Input.Priority"></span>
                </div>
            </div>
            @* Phase 11 (C-3): one selector, grouped by team via native <optgroup> — no JavaScript,
               no cascading round-trip. Only teams/categories in Model.Options (the caller's own
               eligible teams) appear; TeamId itself is derived server-side from the chosen category
               in CreateModel.OnPostAsync, per TICKET-INV-02. *@
            <div class="field">
                <label asp-for="Input.CategoryId">Category<span class="field-required" aria-hidden="true">*</span></label>
                <select asp-for="Input.CategoryId" aria-describedby="category-error">
                    <option value="">Select a category</option>
                    @foreach (var team in Model.Options.Teams)
                    {
                        <optgroup label="@team.TeamName">
                            @foreach (var category in team.Categories)
                            {
                                <option value="@category.CategoryId">@category.CategoryName</option>
                            }
                        </optgroup>
                    }
                </select>
                <span id="category-error" class="field-validation-error" asp-validation-for="Input.CategoryId"></span>
            </div>
            @* Named selector, same pattern as Category above — Project has no team relation, so every
               project in the caller's own organization is offered directly (no grouping needed).
               TicketService.CreateAsync's own organization check (Phase 16) remains the real
               boundary; this is a UI convenience only, resolving the "why do I have to type a raw
               number" usability defect the numeric input previously had. *@
            <div class="field">
                <label asp-for="Input.ProjectId">Project (optional)</label>
                <select asp-for="Input.ProjectId">
                    <option value="">No project</option>
                    @foreach (var project in Model.Options.Projects)
                    {
                        <option value="@project.ProjectId">@project.ProjectName</option>
                    }
                </select>
                <span class="field-validation-error" asp-validation-for="Input.ProjectId"></span>
            </div>
        </div>

        <button type="submit" class="btn-primary">Create ticket</button>
    </form>

    <p><a class="back-link" asp-page="/Tickets/Index">&larr; Back to work queue</a></p>
}
