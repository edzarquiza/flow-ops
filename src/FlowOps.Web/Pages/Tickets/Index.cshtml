@page
@using FlowOps.Application.Tickets
@using FlowOps.Domain.Tickets
@model FlowOps.Web.Pages.Tickets.IndexModel
@{
    ViewData["Title"] = "Work queue";
}

@{
    var workQueuePreserveFields = new Dictionary<string, string?>
    {
        ["filter"] = Model.Filter == TicketQueueFilter.None ? null : Model.Filter.ToString(),
    };
}
<div class="validation-summary-errors" asp-validation-summary="ModelOnly" role="alert"></div>
<div class="page-header">
    <div class="page-header__top">
        <div class="section-head section-head--plain">
            <div class="page-header__title-row">
                <h1>Work queue</h1>
                <div class="page-header__metric">
                    <span class="page-header__metric-value">@Model.Queue.TotalCount</span>
                    <span class="page-header__metric-label">ticket@(Model.Queue.TotalCount == 1 ? "" : "s")</span>
                </div>
            </div>
            <p class="page-context">Your operational workspace.</p>
        </div>
        @await Html.PartialAsync("_SearchBox", new FlowOps.Web.SearchBoxViewModel("Search tickets...", Model.Search, workQueuePreserveFields))
    </div>
    <div class="page-actions">
        @if (Model.CanCreateTicket)
        {
            <a class="btn-primary" asp-page="/Tickets/Create">New ticket</a>
        }
        <a class="btn" asp-page="/Tickets/AtRisk">At-risk work</a>
    </div>

    @* Phase 10: the dashboard's KPI cards link here with a closed, named filter (never a
       general search) — CLAUDE.md §22's "clickable through to the filtered work it
       represents". Shown as text, with a link back to the unfiltered queue. *@
    @if (Model.Filter != TicketQueueFilter.None)
    {
        <p class="page-filter-note">
            Filtered to:
            @(Model.Filter switch
            {
                TicketQueueFilter.OpenWork => "Open Work",
                TicketQueueFilter.Overdue => "Overdue",
                TicketQueueFilter.ResolvedRecently => "Resolved in the last 90 days",
                _ => Model.Filter.ToString(),
            })
            — <a class="text-link" asp-page="/Tickets/Index">clear filter</a>
        </p>
    }
</div>

@* Phase 25 §10/§17: the same filter-bar grammar the Dashboard's date filter already uses (plain
   GET form, Apply button, auto-submit-on-change progressive enhancement) — a second, independent
   filter dimension from the TicketQueueFilter KPI-links above, so both can be active together
   (e.g. "Overdue" narrowed further to "Due this week"). *@
<form method="get" class="filter-bar" aria-label="Date filter" data-autosubmit>
    <input type="hidden" name="filter" value="@(Model.Filter == TicketQueueFilter.None ? "" : Model.Filter.ToString())" />
    <input type="hidden" name="search" value="@Model.Search" />
    <div class="filter-bar__field">
        <label for="dateField">Date</label>
        <select id="dateField" name="dateField">
            <option value="@QueueDateField.Created" selected="@(Model.DateField == QueueDateField.Created)">Created</option>
            <option value="@QueueDateField.PlannedStart" selected="@(Model.DateField == QueueDateField.PlannedStart)">Planned start</option>
            <option value="@QueueDateField.Due" selected="@(Model.DateField == QueueDateField.Due)">Due</option>
            <option value="@QueueDateField.Resolved" selected="@(Model.DateField == QueueDateField.Resolved)">Resolved</option>
        </select>
    </div>
    <div class="filter-bar__field">
        <label for="range">Range</label>
        <select id="range" name="range">
            <option value="@DateRangeOption.AllTime" selected="@(Model.DateRangeOption == DateRangeOption.AllTime)">All time</option>
            <option value="@DateRangeOption.Today" selected="@(Model.DateRangeOption == DateRangeOption.Today)">Today</option>
            <option value="@DateRangeOption.ThisWeek" selected="@(Model.DateRangeOption == DateRangeOption.ThisWeek)">This week</option>
            <option value="@DateRangeOption.ThisMonth" selected="@(Model.DateRangeOption == DateRangeOption.ThisMonth)">This month</option>
            <option value="@DateRangeOption.Last7Days" selected="@(Model.DateRangeOption == DateRangeOption.Last7Days)">Last 7 days</option>
            <option value="@DateRangeOption.Last30Days" selected="@(Model.DateRangeOption == DateRangeOption.Last30Days)">Last 30 days</option>
            <option value="@DateRangeOption.Last90Days" selected="@(Model.DateRangeOption == DateRangeOption.Last90Days)">Last 90 days</option>
            <option value="@DateRangeOption.Custom" selected="@(Model.DateRangeOption == DateRangeOption.Custom)">Custom range</option>
        </select>
    </div>
    @if (Model.DateRangeOption == DateRangeOption.Custom)
    {
        <div class="filter-bar__field">
            <label for="from">From</label>
            <input id="from" type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="filter-bar__field">
            <label for="to">To</label>
            <input id="to" type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
    }
    <div class="filter-bar__actions">
        <button type="submit" class="btn">Apply</button>
        @if (Model.HasDateFilter)
        {
            <a class="btn" asp-page="/Tickets/Index" asp-route-filter="@(Model.Filter == TicketQueueFilter.None ? null : Model.Filter.ToString())" asp-route-search="@Model.Search">Clear dates</a>
        }
    </div>
</form>
<script src="~/js/dashboard-filters.js" asp-append-version="true"></script>

@* Visual-consistency pass: the same .panel--focus surface the dashboard's "What needs attention"
   already uses for this exact .q-list/.q-row component — the ticket list is this page's entire
   reason for existing, exactly the kind of "genuinely a distinct object" Principle 3 reserves a
   border for, and it was the one place still rendering the shared row component bare. Pagination
   stays outside the panel (navigation chrome, not the list surface itself). *@
@if (Model.Queue.TotalCount == 0)
{
    <div class="panel panel--focus">
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <div class="empty-state">
                <p class="empty-state__title">No tickets found</p>
                <p>No tickets matched "@Model.Search".</p>
                <p><a class="back-link" asp-page="/Tickets/Index" asp-route-filter="@(Model.Filter == TicketQueueFilter.None ? null : Model.Filter.ToString())">Clear search</a></p>
            </div>
        }
        else
        {
            <p class="empty-state">
                @(Model.HasDateFilter
                    ? "No work matches the selected date range."
                    : Model.Filter == TicketQueueFilter.None
                        ? "No tickets are visible to you right now."
                        : "No tickets match this filter right now.")
            </p>
        }
    </div>
}
else
{
    var workQueueRouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary
    {
        { "filter", Model.Filter.ToString() },
        { "search", Model.Search },
        { "dateField", Model.DateField.ToString() },
        { "range", Model.DateRangeOption.ToString() },
        { "from", Model.From?.ToString("yyyy-MM-dd") },
        { "to", Model.To?.ToString("yyyy-MM-dd") },
    };
    await Html.RenderPartialAsync(
        "_Pagination",
        FlowOps.Web.PaginationViewModel.For(
            "/Tickets/Index",
            Model.Queue,
            workQueueRouteValues,
            "Work queue pagination",
            FlowOps.Web.PaginationPlacement.Top));

    @* Phase 11: composed rows, not a nine-column grid — see .q-row's own doc comment in
       flowops.css. Category was dropped (constant within a single-team queue, no information per
       row); it stays available as a future filter rather than a repeated column. Each row is a
       single <a>, so keyboard navigation and middle-click both still work; the rail is decorative
       reinforcement here (status is already a word in .q-meta), so it's aria-hidden. *@
    <div class="panel panel--focus">
        <div class="q-list">
            @foreach (var ticket in Model.Queue.Items)
            {
                var slaText = ticket.Sla.Status.ToString();
                var slaClass = slaText == "Breached" ? "is-breached" : slaText == "AtRisk" ? "is-at-risk" : "";
                var severityClass = ticket.Priority.ToString().ToLowerInvariant();
                <a class="q-row @slaClass" asp-page="/Tickets/Details" asp-route-id="@ticket.Id">
                    <div class="q-main">
                        <div class="q-title">@ticket.Title</div>
                        <div class="q-meta">
                            <span class="q-ref">@ticket.Reference</span><span class="q-dot" aria-hidden="true">&middot;</span>
                            <span>@ticket.TeamName</span><span class="q-dot" aria-hidden="true">&middot;</span>
                            <span>@(ticket.AssigneeDisplayName ?? "Unassigned")</span><span class="q-dot" aria-hidden="true">&middot;</span>
                            <span class="status-badge status-badge--compact @FlowOps.Web.StatusBadgeDisplay.CssClass(ticket.Status)">@FlowOps.Web.WorkflowRail.Label(ticket.Status)</span><span class="q-dot" aria-hidden="true">&middot;</span>
                            <time class="mono" datetime="@ticket.CreatedAt.ToString("O")" title="@ticket.CreatedAt.ToString("u")">@FlowOps.Web.SlaDisplay.Format(DateTimeOffset.UtcNow - ticket.CreatedAt) ago &middot; @ticket.CreatedAt.ToString("MMM d, yyyy")</time>
                        </div>
                    </div>
                    <div class="q-sev-col">
                        <div class="severity severity--compact severity--@severityClass">
                            <i class="severity__bar" aria-hidden="true"></i>
                            <span class="severity__label">@ticket.Priority</span>
                        </div>
                    </div>
                    <div class="q-rail-col" aria-hidden="true">
                        @{ await Html.RenderPartialAsync("_WorkflowRail", new FlowOps.Web.RailViewModel(ticket.Status, ticket.Sla)); }
                    </div>
                    <div class="q-sla" title="SLA due @ticket.Sla.DueAt.ToString("u")">
                        <span class="q-sla__state">@ticket.Sla.Status</span>
                        @if (FlowOps.Web.SlaDisplay.Remaining(ticket.Sla) is { } remaining)
                        {
                            <span class="q-sla__time">@remaining</span>
                        }
                    </div>
                </a>
            }
        </div>
    </div>

    @await Html.PartialAsync(
        "_Pagination",
        FlowOps.Web.PaginationViewModel.For(
            "/Tickets/Index",
            Model.Queue,
            workQueueRouteValues,
            "Work queue pagination"))
}
