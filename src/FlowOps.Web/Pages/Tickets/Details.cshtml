@page "{id:int}"
@using FlowOps.Application.Tickets
@using FlowOps.Domain.Tickets
@model FlowOps.Web.Pages.Tickets.DetailsModel
@{
    ViewData["Title"] = $"{Model.Ticket.Reference} — {Model.Ticket.Title}";

    // Visual-refresh pass: status now carries its own tone (StatusBadgeDisplay), reversing the
    // earlier neutral-pill decision — priority stays the height-encoded .severity mark, never a
    // chip; "chip" is still reserved for nothing on this page.
    var severityClass = Model.Ticket.Priority.ToString().ToLowerInvariant();
    var statusClass = FlowOps.Web.StatusBadgeDisplay.CssClass(Model.Ticket.Status);
    var slaStateClass = Model.Ticket.Sla.Status switch
    {
        FlowOps.Domain.Sla.SlaStatus.Met => "met",
        FlowOps.Domain.Sla.SlaStatus.Within => "within",
        FlowOps.Domain.Sla.SlaStatus.Paused => "paused",
        FlowOps.Domain.Sla.SlaStatus.AtRisk => "at-risk",
        FlowOps.Domain.Sla.SlaStatus.Breached => "breached",
        _ => "within",
    };

    // Phase 25 §9: due-date overdue is a distinct concept from SLA breach — a ticket can be one,
    // the other, both, or neither. Never derived from Sla.Status; DueDate/terminal-status only,
    // the exact condition AttentionPolicy's own Overdue signal already uses.
    var isTerminal = Model.Ticket.Status is FlowOps.Domain.Tickets.Status.Resolved or FlowOps.Domain.Tickets.Status.Closed;
    var isOverdue = !isTerminal && Model.Ticket.DueDate is { } due && due < DateTimeOffset.UtcNow;
}

<div class="validation-summary-errors" asp-validation-summary="All" role="alert"></div>

@* ============ HEADER / IDENTITY: "this is the ticket I am looking at" — the same shared
   page-header component every other page uses, so Ticket Detail opens with the same visual
   grammar as Work Queue/At-Risk/Dashboard rather than a bespoke title block. ============ *@
<div class="page-header">
    <div class="page-header__top">
        <div class="section-head section-head--plain">
            <div class="page-header__title-row">
                <h1>@Model.Ticket.Title</h1>
                <span class="page-header__count mono">@Model.Ticket.Reference</span>
            </div>
            <p class="page-context">@FlowOps.Web.WorkTypeDisplay.ToDisplayName(Model.Ticket.WorkType) &middot; @Model.Ticket.TeamName</p>
        </div>
    </div>
    <div class="ticket-chips">
        <span class="status-badge @statusClass">@FlowOps.Web.WorkflowRail.Label(Model.Ticket.Status)</span>
        <div class="severity severity--@severityClass">
            <i class="severity__bar" aria-hidden="true"></i>
            <span class="severity__label">@Model.Ticket.Priority priority</span>
        </div>
    </div>
</div>

@* ============ JOURNEY: where the ticket sits in its lifecycle ============ *@
<div class="zone">
    @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("Deadline & workflow")); }
    <div class="ticket-rail-wrap">
        @{ await Html.RenderPartialAsync("_WorkflowRail", new FlowOps.Web.RailViewModel(Model.Ticket.Status, Model.Ticket.Sla, Expanded: true)); }
    </div>
    <a class="guide-help-link" asp-page="/Guide/SlaAndAttention">How does SLA work?</a>
</div>

@* ============ SLA / OWNERSHIP: side-by-side panels rather than two flat stacks of full-width
   rows — related-but-distinct facts about the same ticket, at a glance. ============ *@
<div class="ticket-zone-grid">
    <div class="panel">
        <h3>Service deadline</h3>
        <div class="sla-state sla-state--@slaStateClass sla-state--lede">
            @FlowOps.Web.SlaDisplay.StatusLabel(Model.Ticket.Sla.Status)
            @if (FlowOps.Web.SlaDisplay.Remaining(Model.Ticket.Sla) is { } remaining)
            {
                @($" — {remaining}")
            }
        </div>
        <div class="panel__meta">
            Deadline <span class="panel__value mono"><time datetime="@Model.Ticket.Sla.DueAt.ToString("O")" title="@Model.Ticket.Sla.DueAt.ToString("u")">@Model.Ticket.Sla.DueAt.ToString("yyyy-MM-dd HH:mm")</time></span><br>
            Target <span class="panel__value">@Model.Ticket.Sla.TargetMinutes minutes</span> &middot; Paused <span class="panel__value">@Model.Ticket.Sla.PausedMinutes minutes</span><br>
            Due date
            @if (Model.Ticket.DueDate is { } dueDate)
            {
                <span class="panel__value"><time datetime="@dueDate.ToString("O")" title="@dueDate.ToString("u")">@dueDate.ToString("yyyy-MM-dd HH:mm")</time></span>
                @if (isOverdue)
                {
                    @* Phase 25 §9: distinct from SLA breach — this is the planning due date, never
                       derived from Sla.Status, and shown even when SLA itself is still healthy. *@
                    <span class="flag-text flag-text--danger" title="Past due — this is the planning due date, not the service deadline">Past due</span>
                }
            }
            else
            {
                <span class="panel__value panel__value--muted">Not set</span>
            }
            <br>
            Planned start
            @if (Model.Ticket.PlannedStartDate is { } plannedStart)
            {
                <span class="panel__value"><time datetime="@plannedStart.ToString("O")" title="@plannedStart.ToString("u")">@plannedStart.ToString("yyyy-MM-dd HH:mm")</time></span>
            }
            else
            {
                <span class="panel__value panel__value--muted">Not set</span>
            }
        </div>
    </div>
    <div class="panel">
        <h3>Ownership</h3>
        <div class="panel__meta">
            Requester <span class="panel__value">@Model.Ticket.RequesterDisplayName</span> &middot;
            Assignee <span class="panel__value @(Model.Ticket.AssigneeDisplayName is null ? "panel__value--muted" : "")">@(Model.Ticket.AssigneeDisplayName ?? "Unassigned")</span><br>
            Team <span class="panel__value">@Model.Ticket.TeamName</span> &middot;
            Category <span class="panel__value">@Model.Ticket.CategoryName</span><br>
            Project <span class="panel__value @(Model.Ticket.ProjectName is null ? "panel__value--muted" : "")">@(Model.Ticket.ProjectName ?? "None")</span>
            @if (Model.Ticket.ProjectName is not null)
            {
                <br>
                @* Read-only orientation (Phase 28B): where this ticket sits in project planning. *@
                @if (Model.Ticket.Sprint is { } sprint)
                {
                    @* The sprint's own name usually already says "Sprint" ("Sprint 2 - Pilot devices"); only add the label when it does not. *@
                    @if (!sprint.Name.Contains("sprint", StringComparison.OrdinalIgnoreCase))
                    {
                        <text>Sprint </text>
                    }
                    <span class="panel__value">
                        <a class="text-link" asp-page="/Projects/SprintDetail" asp-route-id="@sprint.ProjectId" asp-route-sprintId="@sprint.SprintId">@sprint.Name</a>
                        <span class="cell-muted">
                            &middot; @FlowOps.Web.SprintDisplay.TicketSprintLabel(sprint.Status, sprint.InPlanned) &middot; @FlowOps.Web.SprintDisplay.Range(sprint.StartDate, sprint.EndDate)
                        </span>
                    </span>
                    @if (sprint.CarriedFromSprint is not null)
                    {
                        <span class="carried-note" title="This ticket was unfinished when @sprint.CarriedFromSprint was completed">Carried from @sprint.CarriedFromSprint</span>
                    }
                }
                else
                {
                    <span class="panel__value panel__value--muted">No sprint</span>
                }
            }
        </div>
        <p class="ticket-subtitle ticket-subtitle--panel">
            Created
            <time datetime="@Model.Ticket.CreatedAt.ToString("O")" title="@Model.Ticket.CreatedAt.ToString("u")">@Model.Ticket.CreatedAt.ToString("yyyy-MM-dd HH:mm")</time>
            &middot; Last updated
            <time datetime="@Model.Ticket.UpdatedAt.ToString("O")" title="@Model.Ticket.UpdatedAt.ToString("u")">@Model.Ticket.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</time>
        </p>
    </div>
</div>

@* ============ ATTENTION BRIEF (Phase 30): explains AttentionPolicy's existing decision — never
   a second decision, never a score. Absent entirely for a ticket with no current signals
   (including every terminal ticket), so a normal ticket's page is unchanged. Read-only: no
   action here changes the ticket — existing menus above remain the only way to do that. ============ *@
@if (Model.AttentionBrief is { } brief)
{
    <div class="zone">
        @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("Why this needs attention")); }
        <div class="panel attention-brief">
            <div class="attention-brief__section">
                <h3>Signals</h3>
                <ul class="attention-brief__signals">
                    @foreach (var signal in brief.Signals)
                    {
                        var sevClass = signal.Severity.ToString().ToLowerInvariant() switch
                        {
                            "critical" => "crit",
                            "high" => "high",
                            _ => "med",
                        };
                        <li>
                            <span class="sev @sevClass" aria-hidden="true"><i></i><span>@signal.Severity</span></span>
                            <span>@signal.Headline</span>
                        </li>
                    }
                </ul>
            </div>
            @if (brief.RecentEvents.Count > 0)
            {
                <div class="attention-brief__section">
                    <h3>What changed</h3>
                    @foreach (var entry in brief.RecentEvents)
                    {
                        <p class="attention-brief__event">
                            <time class="mono" datetime="@entry.OccurredAt.ToString("O")" title="@entry.OccurredAt.ToString("u")">@entry.OccurredAt.ToString("MMM d, h:mm tt")</time>
                            <span>@FlowOps.Web.TimelineDisplay.Title(entry)@(FlowOps.Web.TimelineDisplay.Detail(entry) is { } detail ? $" — {detail}" : "")</span>
                        </p>
                    }
                </div>
            }
            @if (brief.SuggestedNextStep is { } nextStep)
            {
                <div class="attention-brief__section attention-brief__next-step">
                    <h3>Suggested next step</h3>
                    <p>@nextStep</p>
                </div>
            }
        </div>
    </div>
}

@* ============ CONTENT: the actual work, given room to be read ============ *@
<div class="zone">
    @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("Description")); }
    <div class="ticket-description">@Model.Ticket.Description</div>
</div>

@* ============ ACTIONS — kept as its own zone: what can I do next ============ *@
<div class="zone">
    @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("What you can do next")); }
    @if (!Model.Actions.Any)
    {
        <p class="empty-state">No workflow actions are available to you for this ticket right now.</p>
    }
    else
    {
        @* Each form posts to its own named handler; antiforgery is on by default for Razor
           Pages forms and is deliberately not disabled (CLAUDE.md §12). Exactly one primary
           (teal) action per state — Assign/StartWork/Resolve/Close are mutually exclusive by
           status, so at most one ever renders at a time; everything else stays a ghost button.
           One flat row, matching the dashboard's own restrained "one row of controls" grammar
           (.page-actions/.setup__action) — an action that needs more input (Put on hold/Resolve/
           Reopen) stays exactly one button tall in the row via .reveal, a neutral zero-JS
           expander (the same checkbox-hack .confirm already uses for destructive actions), rather
           than permanently occupying a differently-sized boxed form next to plain buttons. *@
        <div class="workflow-actions">
            @if (Model.Actions.Assign)
            {
                <form method="post" asp-page-handler="Assign" asp-route-id="@Model.Ticket.Id">
                    <button type="submit" class="btn-primary">Assign to me</button>
                </form>
            }
            @if (Model.Actions.AssignToOther && Model.AssignableMembers.Count > 0)
            {
                @* Native select + button, no JS — the same "every action works with JavaScript
                   off" discipline every other form on this page follows. AssignableMembers is
                   already scoped to the ticket's own team and the caller's own assign authority
                   (TicketQueryService.GetAssignableTeamMembersAsync); TicketService.AssignAsync
                   re-checks both independently regardless of what this list offered. *@
                <form method="post" asp-page-handler="AssignTo" asp-route-id="@Model.Ticket.Id" class="assign-to-form">
                    <label for="assign-to-select" class="sr-only">Assign to</label>
                    <select id="assign-to-select" name="assigneeId">
                        @foreach (var member in Model.AssignableMembers)
                        {
                            <option value="@member.UserId">@member.DisplayName</option>
                        }
                    </select>
                    <button type="submit" class="btn">Assign</button>
                </form>
            }
            @if (Model.Actions.StartWork)
            {
                <form method="post" asp-page-handler="StartWork" asp-route-id="@Model.Ticket.Id">
                    <button type="submit" class="btn-primary">Start work</button>
                </form>
            }
            @if (Model.Actions.Unassign)
            {
                <form method="post" asp-page-handler="Unassign" asp-route-id="@Model.Ticket.Id">
                    <button type="submit" class="btn">Unassign</button>
                </form>
            }
            @if (Model.Actions.PutOnHold)
            {
                <div class="reveal">
                    <input type="checkbox" id="reveal-hold" class="reveal-toggle" />
                    <label for="reveal-hold" class="btn reveal-trigger">Put on hold</label>
                    <div class="reveal-panel">
                        <form method="post" asp-page-handler="PutOnHold" asp-route-id="@Model.Ticket.Id">
                            <div class="field">
                                <label asp-for="Input.PendingReason">Reason for putting on hold</label>
                                <input asp-for="Input.PendingReason" aria-describedby="hold-error" />
                                <span id="hold-error" class="field-validation-error" asp-validation-for="Input.PendingReason"></span>
                            </div>
                            <div class="reveal-panel__actions">
                                <button type="submit" class="btn-primary">Put on hold</button>
                                <label for="reveal-hold" class="btn">Cancel</label>
                            </div>
                        </form>
                    </div>
                </div>
            }
            @if (Model.Actions.Resume)
            {
                <form method="post" asp-page-handler="Resume" asp-route-id="@Model.Ticket.Id">
                    <button type="submit" class="btn">Resume</button>
                </form>
            }
            @if (Model.Actions.Resolve)
            {
                <div class="reveal">
                    <input type="checkbox" id="reveal-resolve" class="reveal-toggle" />
                    <label for="reveal-resolve" class="btn-primary reveal-trigger">Resolve</label>
                    <div class="reveal-panel">
                        <form method="post" asp-page-handler="Resolve" asp-route-id="@Model.Ticket.Id">
                            <div class="field">
                                <label asp-for="Input.ResolutionCode">Resolution</label>
                                <select asp-for="Input.ResolutionCode">
                                    @foreach (var resolution in Enum.GetValues<Resolution>())
                                    {
                                        <option value="@resolution">@FlowOps.Web.ResolutionDisplay.ToDisplayName(resolution)</option>
                                    }
                                </select>
                            </div>
                            <div class="field">
                                <label asp-for="Input.ResolutionNotes">Resolution notes</label>
                                <textarea asp-for="Input.ResolutionNotes" rows="3" aria-describedby="resolve-error"></textarea>
                                <span id="resolve-error" class="field-validation-error" asp-validation-for="Input.ResolutionNotes"></span>
                            </div>
                            <div class="reveal-panel__actions">
                                <button type="submit" class="btn-primary">Resolve</button>
                                <label for="reveal-resolve" class="btn">Cancel</label>
                            </div>
                        </form>
                    </div>
                </div>
            }
            @if (Model.Actions.Close)
            {
                <form method="post" asp-page-handler="Close" asp-route-id="@Model.Ticket.Id">
                    <button type="submit" class="btn-primary">Close</button>
                </form>
            }
            @if (Model.Actions.Reopen)
            {
                <div class="reveal">
                    <input type="checkbox" id="reveal-reopen" class="reveal-toggle" />
                    <label for="reveal-reopen" class="btn reveal-trigger">Reopen</label>
                    <div class="reveal-panel">
                        <form method="post" asp-page-handler="Reopen" asp-route-id="@Model.Ticket.Id">
                            <div class="field">
                                <label asp-for="Input.ReopenReason">Reason for reopening</label>
                                <input asp-for="Input.ReopenReason" aria-describedby="reopen-error" />
                                <span id="reopen-error" class="field-validation-error" asp-validation-for="Input.ReopenReason"></span>
                            </div>
                            <div class="reveal-panel__actions">
                                <button type="submit" class="btn">Reopen</button>
                                <label for="reveal-reopen" class="btn">Cancel</label>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>

@* ============ EDIT — Phase 30C (ADR-0033): correcting Priority/Category/Team/Due date after
   creation. Its own zone, same .reveal disclosure grammar as Put on hold/Resolve/Reopen above,
   so a field that needs more than a bare click stays exactly one button tall in the row rather
   than a permanently-open form. ============ *@
@if (Model.Actions.AnyEdit)
{
    <div class="zone">
        @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("Edit ticket details")); }
        <div class="workflow-actions">
            @if (Model.Actions.EditPriority)
            {
                <div class="reveal">
                    <input type="checkbox" id="reveal-edit-priority" class="reveal-toggle" />
                    <label for="reveal-edit-priority" class="btn reveal-trigger">Change priority</label>
                    <div class="reveal-panel">
                        <form method="post" asp-page-handler="ChangePriority" asp-route-id="@Model.Ticket.Id">
                            <div class="field">
                                <label for="edit-priority-select">New priority</label>
                                <select id="edit-priority-select" name="Input.NewPriority">
                                    @foreach (var priority in Enum.GetValues<Priority>())
                                    {
                                        <option value="@priority" selected="@(priority == Model.Ticket.Priority)">@priority</option>
                                    }
                                </select>
                            </div>
                            <div class="reveal-panel__actions">
                                <button type="submit" class="btn-primary">Save</button>
                                <label for="reveal-edit-priority" class="btn">Cancel</label>
                            </div>
                        </form>
                    </div>
                </div>
            }
            @if (Model.Actions.EditCategory)
            {
                var ownTeamCategories = Model.EditOptions.Teams.FirstOrDefault(t => t.TeamId == Model.Ticket.TeamId)?.Categories ?? [];
                @if (ownTeamCategories.Count > 1)
                {
                    <div class="reveal">
                        <input type="checkbox" id="reveal-edit-category" class="reveal-toggle" />
                        <label for="reveal-edit-category" class="btn reveal-trigger">Change category</label>
                        <div class="reveal-panel">
                            <form method="post" asp-page-handler="ChangeCategory" asp-route-id="@Model.Ticket.Id">
                                <div class="field">
                                    <label for="edit-category-select">New category</label>
                                    <select id="edit-category-select" name="Input.NewCategoryId">
                                        @foreach (var category in ownTeamCategories)
                                        {
                                            <option value="@category.CategoryId" selected="@(category.CategoryId == Model.Ticket.CategoryId)">@category.CategoryName</option>
                                        }
                                    </select>
                                </div>
                                <div class="reveal-panel__actions">
                                    <button type="submit" class="btn-primary">Save</button>
                                    <label for="reveal-edit-category" class="btn">Cancel</label>
                                </div>
                            </form>
                        </div>
                    </div>
                }
            }
            @* Offered only when there is a genuine alternative team to move to — a lone team in
               the caller's own reach would make this picker able to select nothing but the
               ticket's current team, an action certain to be a no-op. *@
            @if (Model.Actions.EditTeam && Model.EditOptions.Teams.Count > 1)
            {
                <div class="reveal">
                    <input type="checkbox" id="reveal-edit-team" class="reveal-toggle" />
                    <label for="reveal-edit-team" class="btn reveal-trigger">Change team</label>
                    <div class="reveal-panel">
                        <form method="post" asp-page-handler="ChangeTeam" asp-route-id="@Model.Ticket.Id">
                            <div class="field">
                                <label for="edit-team-select">New team &amp; category</label>
                                <select id="edit-team-select" name="Input.NewTeamCategoryId">
                                    @foreach (var team in Model.EditOptions.Teams)
                                    {
                                        <optgroup label="@team.TeamName">
                                            @foreach (var category in team.Categories)
                                            {
                                                <option value="@category.CategoryId" selected="@(category.CategoryId == Model.Ticket.CategoryId)">@category.CategoryName</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                            </div>
                            <p class="ticket-subtitle">Moving to a different team always clears the current assignee — they may not be a member of the new team.</p>
                            <div class="reveal-panel__actions">
                                <button type="submit" class="btn-primary">Save</button>
                                <label for="reveal-edit-team" class="btn">Cancel</label>
                            </div>
                        </form>
                    </div>
                </div>
            }
            @if (Model.Actions.EditDueDate)
            {
                <div class="reveal">
                    <input type="checkbox" id="reveal-edit-duedate" class="reveal-toggle" />
                    <label for="reveal-edit-duedate" class="btn reveal-trigger">Change due date</label>
                    <div class="reveal-panel">
                        <form method="post" asp-page-handler="ChangeDueDate" asp-route-id="@Model.Ticket.Id">
                            <div class="field">
                                <label for="edit-duedate-input">New due date</label>
                                <input id="edit-duedate-input" type="datetime-local" name="Input.NewDueDate"
                                       value="@Model.Ticket.DueDate?.ToString("yyyy-MM-ddTHH:mm")"
                                       aria-describedby="edit-duedate-error" />
                                <span id="edit-duedate-error" class="field-validation-error" asp-validation-for="Input.NewDueDate"></span>
                            </div>
                            <p class="ticket-subtitle">Leave blank to clear the due date.</p>
                            <div class="reveal-panel__actions">
                                <button type="submit" class="btn-primary">Save</button>
                                <label for="reveal-edit-duedate" class="btn">Cancel</label>
                            </div>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
}

@if (Model.Actions.Comment)
{
    @* ============ COMMENTS — its own zone, matching Content/Actions/Activity's own
       plain-heading pattern rather than a bare <h3> sitting inside Actions. ============ *@
    <div class="zone">
        @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("Add a comment")); }
        <form method="post" asp-page-handler="AddComment" asp-route-id="@Model.Ticket.Id">
            <div class="field">
                <label asp-for="Input.CommentBody">Comment</label>
                <textarea asp-for="Input.CommentBody" rows="3" aria-describedby="comment-error"></textarea>
                <span id="comment-error" class="field-validation-error" asp-validation-for="Input.CommentBody"></span>
            </div>
            <div class="field">
                <input asp-for="Input.CommentIsInternal" type="checkbox" />
                <label asp-for="Input.CommentIsInternal">Internal comment (not visible to Viewers)</label>
            </div>
            <button type="submit" class="btn">Add comment</button>
        </form>
    </div>
}

@* ============ ACTIVITY: what has happened, in one merged timeline ============ *@
<div class="zone">
    @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("What has happened")); }
    @* "Comment added" audit events are left out here: the comment itself is the timeline entry (and an
       internal comment must not announce itself to a reader who cannot see it). *@
    @{ var history = Model.History.Where(e => e.EventType != TicketEventType.CommentAdded).ToList(); }
    @if (history.Count == 0)
    {
        <p class="empty-state">No history has been recorded for this ticket yet.</p>
    }
    else
    {
        @* AUDIT-RULE-06: TicketEvent (audit) and TicketComment (human content) are stored and
           queried separately but rendered together here, newest first, as a caption text kept
           from the original table this replaces. An internal comment never reaches this page
           for a caller CanSeeInternalComments denies — that exclusion happened before this list
           was built, not in this markup. Each dot's tone is a small presentation-only mapping
           (TimelinePresentation) over the entry's own Kind/EventType — no new business rule. *@
        <p class="ticket-subtitle">Audit history, most recent first</p>
        <div class="timeline">
            @for (var i = 0; i < history.Count; i++)
            {
                var entry = history[i];
                var isLast = i == history.Count - 1;
                var tone = FlowOps.Web.TimelinePresentation.Tone(entry);
                var dotClass = tone switch
                {
                    FlowOps.Web.TimelineTone.Info => "tl-info",
                    FlowOps.Web.TimelineTone.Warn => "tl-warn",
                    FlowOps.Web.TimelineTone.Paused => "tl-paused",
                    FlowOps.Web.TimelineTone.Resolved => "tl-resolved",
                    FlowOps.Web.TimelineTone.Comment => "tl-comment",
                    _ => "",
                };
                <div class="tl-entry">
                    <div class="tl-gutter" aria-hidden="true">
                        <span class="tl-dot @dotClass"></span>
                        @if (!isLast)
                        {
                            <span class="tl-line"></span>
                        }
                    </div>
                    <div class="tl-body">
                        <time class="tl-when" datetime="@entry.OccurredAt.ToString("O")" title="@entry.OccurredAt.ToString("u")">
                            @entry.OccurredAt.ToString("yyyy-MM-dd HH:mm")
                        </time>
                        @if (entry.Kind == TicketTimelineEntryKind.Comment)
                        {
                            <div class="tl-title">@FlowOps.Web.TimelineDisplay.Title(entry) &middot; @entry.ActorDisplayName</div>
                            <div class="tl-detail">@entry.Body</div>
                        }
                        else
                        {
                            <div class="tl-title">@FlowOps.Web.TimelineDisplay.Title(entry) &middot; @entry.ActorDisplayName</div>
                            @if (FlowOps.Web.TimelineDisplay.Detail(entry) is { } detail)
                            {
                                <div class="tl-detail">@detail</div>
                            }
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<p><a class="back-link" asp-page="/Tickets/Index">&larr; Back to work queue</a></p>
