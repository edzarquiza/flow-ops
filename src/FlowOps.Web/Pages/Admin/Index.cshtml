@page
@model FlowOps.Web.Pages.Admin.IndexModel
@using FlowOps.Domain.Tickets
@{
    ViewData["Title"] = "Admin";
}
<div class="page-header">
    <div class="page-header__top">
        <div class="section-head section-head--plain">
            <div class="page-header__title-row">
                <h1>Admin</h1>
                <span class="page-header__count">@Model.Teams.Count team@(Model.Teams.Count == 1 ? "" : "s")</span>
            </div>
            <p class="page-context">Team and project setup for this organization. Reaching this page proves the Admin-only coarse gate (AUTH-RULE-01), now backed by your current organization's membership role rather than a stale Identity role claim (ADR-0021).</p>
        </div>
        <div class="page-header__actions">
            <a class="btn" asp-page="/Admin/Projects/Index">Manage projects</a>
        </div>
    </div>
</div>

@if (Model.StatusMessage is not null)
{
    await Html.RenderPartialAsync("_Notice", new FlowOps.Web.NoticeViewModel(Model.StatusMessage));
}

<div class="zone">
    @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("Teams")); }
    @if (Model.Teams.Count == 0)
    {
        <p class="empty-state">No teams yet — create your first one below.</p>
    }
    else
    {
        <div class="admin-list">
            @foreach (var team in Model.Teams)
            {
                <a class="admin-list__item" asp-page="/Admin/Teams/Details" asp-route-id="@team.TeamId">
                    <span class="fo-avatar" aria-hidden="true">@FlowOps.Web.InitialsDisplay.From(team.TeamName)</span>
                    <span class="admin-list__name">@team.TeamName</span>
                    @if (!team.IsActive)
                    {
                        <span class="cell-muted">
                            <span class="fo-status-dot fo-status-dot--muted" aria-hidden="true"></span>Inactive
                        </span>
                    }
                    @Html.Raw(Icons.Forward)
                </a>
            }
        </div>
    }
</div>

<div class="zone">
    @{ await Html.RenderPartialAsync("_SectionHeading", new FlowOps.Web.SectionHeadingViewModel("Create a team")); }
    <p class="page-context">
        Every team needs at least one category before a ticket can be filed against it, so both
        are created together here. Renaming, additional categories, and deactivation are managed
        from a team's own page — open a team above once it exists. SLA configuration is not yet
        built.
    </p>

    <div class="validation-summary-errors" asp-validation-summary="ModelOnly" role="alert"></div>
    <form method="post" asp-page-handler="CreateTeam">
        @Html.AntiForgeryToken()
        <div class="field-grid">
            <div class="field">
                <label asp-for="Input.TeamName">Team name<span class="field-required" aria-hidden="true">*</span></label>
                <input asp-for="Input.TeamName" aria-describedby="team-name-error" />
                <span id="team-name-error" class="field-validation-error" asp-validation-for="Input.TeamName"></span>
            </div>
            <div class="field">
                <label asp-for="Input.CategoryName">Category name<span class="field-required" aria-hidden="true">*</span></label>
                <input asp-for="Input.CategoryName" aria-describedby="category-name-error" />
                <span id="category-name-error" class="field-validation-error" asp-validation-for="Input.CategoryName"></span>
            </div>
        </div>
        <div class="field">
            <label asp-for="Input.CategoryWorkType">Category work type<span class="field-required" aria-hidden="true">*</span></label>
            <select asp-for="Input.CategoryWorkType" asp-items="Html.GetEnumSelectList<WorkType>()"></select>
            <span class="field-validation-error" asp-validation-for="Input.CategoryWorkType"></span>
        </div>
        <button type="submit" class="btn-primary">Create team</button>
    </form>
</div>
