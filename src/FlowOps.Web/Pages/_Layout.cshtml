@using System.Security.Claims
@using FlowOps.Application.Accounts
@using FlowOps.Application.Demo
@using FlowOps.Domain.Accounts
@using FlowOps.Application.Platform
@using FlowOps.Application.Planning
@using FlowOps.Application.Tickets
@inject DemoOptions DemoOptions
@inject CurrentUserAccessor CurrentUserAccessor
@inject PlatformUserAccessor PlatformUserAccessor
@inject AccountService AccountService
@inject ProjectPlanningQueryService ProjectPlanningQueryService
@{
    var pageTitle = ViewData["Title"] as string;
    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    // Phase 17: the account area needs the caller's organization role, which the auth cookie never
    // carries (ADR-0008 — role is re-resolved from the database, never trusted from a stale claim).
    // One extra CurrentUserAccessor call per authenticated page render, alongside whatever the
    // PageModel itself already made — accepted deliberately rather than adding a display-only
    // cookie claim, which ADR-0008 already rejected as a category of solution for the same
    // staleness reason, or touching CurrentUserAccessor itself (out of this phase's scope).
    var currentUser = isAuthenticated ? await CurrentUserAccessor.GetCurrentUserAsync(User) : null;

    // Phase 24 (ADR-0023): completely independent of currentUser/OrganizationMembership — see
    // PlatformUserAccessor's own doc comment. Skipped entirely when unauthenticated, same as above.
    var platformAdmin = isAuthenticated ? await PlatformUserAccessor.GetCurrentPlatformAdminAsync(User) : null;

    // Phase 19: the switcher's own data — every organization the caller belongs to. A second,
    // cheap, indexed query alongside the one above; skipped entirely when unauthenticated.
    IReadOnlyList<FlowOps.Application.Tickets.OrganizationOption> availableOrganizations = currentUser is not null
        ? await CurrentUserAccessor.GetAvailableOrganizationsAsync(currentUser.UserId)
        : Array.Empty<FlowOps.Application.Tickets.OrganizationOption>();
    var currentOrganizationName = currentUser is not null
        ? availableOrganizations.FirstOrDefault(o => o.Id == currentUser.OrganizationId)?.Name
        : null;
    var current = ViewContext.RouteData.Values["page"]?.ToString() ?? "";

    // Phase 29D: the sidebar's own project quick-navigation list — gated the same as every other
    // tenant-scoped sidebar item (an organization-less Platform Admin has none to show).
    IReadOnlyList<ProjectNavOption> sidebarProjects = currentUser is not null
        ? await ProjectPlanningQueryService.GetProjectNavOptionsAsync(currentUser)
        : Array.Empty<ProjectNavOption>();

    // Every project sub-page (Overview/Board/Tickets/Sprints/SprintDetail) shares the same
    // {id:int} first route segment — the project's id. The Projects management page itself
    // (/Projects/Index) has no id and is deliberately NOT treated as "inside a project": it is
    // the management/browse destination, not a project's own page (Phase 29D design decision —
    // "Projects" is a navigation group, individual projects are destinations, the management page
    // is a separate, third destination).
    int? insideProjectId = current.StartsWith("/Projects/", StringComparison.Ordinal)
        && int.TryParse(ViewContext.RouteData.Values["id"]?.ToString(), out var routeProjectId)
        ? routeProjectId
        : null;

    // Phase F1-B: whether the "Administration" nav group has anything to show at all — the exact
    // same three conditions each of its own links already checks below, OR'd together, so the
    // group's eyebrow label never renders orphaned above an empty group for an Agent/Viewer.
    var canCreateTicket = currentUser is not null && FlowOps.Domain.Tickets.TicketAccessPolicy.CanCreate(currentUser);
    var showAdministrationGroup = platformAdmin is not null
        || (currentUser is not null && (FlowOps.Domain.Organizations.OrganizationAccessPolicy.CanManageMembers(currentUser)
            || FlowOps.Domain.Directory.DirectoryAccessPolicy.CanManageTeams(currentUser)));

    // Phase 29C: the saved appearance is rendered straight into <html data-theme="...">, so the right
    // theme is present on the first byte (no flash, no script, nothing for the CSP to object to).
    // "system" is resolved by CSS itself (prefers-color-scheme), so it follows the OS live. Anonymous
    // pages (login, register, invitation) are always dark.
    var appearance = AppearancePreference.Dark;
    if (isAuthenticated && Guid.TryParse(User.FindFirstValue(ClaimTypes.NameIdentifier), out var appearanceUserId))
    {
        appearance = await AccountService.GetAppearanceAsync(appearanceUserId);
    }

    var theme = appearance.ToString().ToLowerInvariant();

    // Rendered twice (desktop top-right toolbar, mobile sidebar) via the shared _IdentityBlock
    // partial — see that partial's own doc comment for why.
    var identity = new AccountAreaViewModel(currentUser, User.Identity?.Name ?? string.Empty, availableOrganizations, currentOrganizationName);
}
<!DOCTYPE html>
<html lang="en" data-theme="@theme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(string.IsNullOrEmpty(pageTitle) ? "FlowOps" : $"{pageTitle} — FlowOps")</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    @* Brand-mark-integration pass: evergreen browsers use the SVG above directly; these two are
       for the cases that can't — iOS's home-screen icon has no SVG support at all, and a 32×32 PNG
       covers any browser old enough to predate SVG favicon support. Both are one-time exported
       raster copies of the same favicon.svg geometry, not a second design. *@
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32.png" />
    <link rel="apple-touch-icon" href="~/apple-touch-icon.png" />
    <link rel="stylesheet" href="~/flowops.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>

    @* CLAUDE.md §14: "A persistent banner identifies the site as a portfolio demonstration with
       synthetic data." Shown site-wide, authenticated or not — unlike the shell below, this is not
       gated on session state. *@
    @if (DemoOptions.Enabled)
    {
        <div class="demo-banner" role="status">Portfolio demo — all data is synthetic.</div>
    }

    @* The application shell (sidebar + workspace) renders only for an authenticated request —
       Login and AccessDenied are reachable anonymously and must not imply a signed-in session.
       CLAUDE.md §2 rule 8 / §6.2: this is presentation only. Every link below leads to a page
       that independently re-checks authorization server-side regardless of whether it is shown
       here (e.g. Create Ticket 403s a Viewer exactly as it did before this nav existed). *@
    @if (isAuthenticated)
    {
        @* A checkbox-driven off-canvas panel — the standard no-JavaScript pattern for a mobile
           nav toggle (CLAUDE.md §11.1: no JS framework, and this needs none at all). Unchecked by
           default; the mobile top bar's own label toggles it, and the scrim label closes it. *@
        <input type="checkbox" id="fo-nav-toggle" class="fo-nav-toggle-input" />
        <div class="fo-shell">
            <div class="fo-mobile-bar">
                <label for="fo-nav-toggle" class="fo-nav-toggle-btn" aria-label="Toggle navigation">@Html.Raw(Icons.Menu)</label>
                <a class="fo-brand fo-brand--compact" asp-page="/Index">@Html.Raw(Icons.BrandMark(20))<span>FlowOps</span></a>
            </div>
            <label for="fo-nav-toggle" class="fo-nav-scrim" aria-hidden="true"></label>

            <aside class="fo-sidebar" aria-label="Primary">
                <a class="fo-brand" asp-page="/Index">
                    @Html.Raw(Icons.BrandMark())
                    <span>FlowOps</span>
                </a>

                @* Step 1: organization context sits directly beneath the brand, not in the
                   top-right toolbar — the same secure, data-only switcher as before
                   (ADR-0018/Step 27), just relocated. A single organization renders as plain
                   text; nothing about switching security changed. *@
                @if (currentUser is not null && availableOrganizations.Count > 1)
                {
                    <details class="fo-org-switcher fo-org-switcher--sidebar">
                        <summary>@currentOrganizationName</summary>
                        <ul>
                            @foreach (var org in availableOrganizations)
                            {
                                <li>
                                    @if (org.Id == currentUser.OrganizationId)
                                    {
                                        <span class="fo-org-switcher__current" aria-current="true">@org.Name <span aria-hidden="true">&#10003;</span></span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page="/Organization/Switch">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="organizationId" value="@org.Id" />
                                            <button type="submit">@org.Name</button>
                                        </form>
                                    }
                                </li>
                            }
                        </ul>
                    </details>
                }
                else if (currentOrganizationName is not null)
                {
                    <div class="fo-org-switcher fo-org-switcher--single fo-org-switcher--sidebar">@currentOrganizationName</div>
                }

                <nav class="fo-sidebar__nav" aria-label="Primary navigation">
                    @* Phase 24: a Platform Admin with no organization membership at all
                       (currentUser is null) has nothing tenant-scoped to see here — Dashboard/Work
                       Queue/At-Risk/Create Ticket all 403 via CurrentUserAccessor regardless, so
                       showing them would only be dead-looking links. Gated the same way
                       Members/Admin already are; an ordinary tenant user (the overwhelming common
                       case) always has a non-null currentUser and sees these exactly as before. *@
                    @if (currentUser is not null)
                    {
                        <p class="fo-sidebar__nav-label">Work</p>
                        <a asp-page="/Index" aria-current="@(current == "/Index" ? "page" : null)">
                            @Html.Raw(Icons.Dashboard)
                            <span>Dashboard</span>
                        </a>
                        <a asp-page="/Tickets/Index" aria-current="@(current == "/Tickets/Index" ? "page" : null)">
                            @Html.Raw(Icons.WorkQueue)
                            <span>Work Queue</span>
                        </a>
                        <a asp-page="/Tickets/AtRisk" aria-current="@(current == "/Tickets/AtRisk" ? "page" : null)">
                            @Html.Raw(Icons.AtRisk)
                            <span>At-Risk</span>
                        </a>
                        @* Phase F1-B: shown only when TicketAccessPolicy.CanCreate allows it (the
                           same policy Tickets/Create.cshtml.cs itself enforces server-side) — a
                           Viewer previously saw this link despite being blocked from submitting it. *@
                        @if (canCreateTicket)
                        {
                            <a asp-page="/Tickets/Create" aria-current="@(current == "/Tickets/Create" ? "page" : null)">
                                @Html.Raw(Icons.Create)
                                <span>Create Ticket</span>
                            </a>
                        }
                        @* Phase 29D: Projects is a navigation group (ADR-0029's planning surfaces —
                           Overview/Board/Tickets/Sprints), not a direct link — a native <details>
                           disclosure, the same no-JavaScript pattern the org switcher above
                           already uses (CLAUDE.md §11.1), styled to sit inline in the link list
                           rather than as a floating dropdown. Open to every organization member —
                           what a caller sees inside is ordinary ticket visibility, and every
                           action is re-authorized server-side regardless of what this affordance
                           shows. Auto-expanded (`open`) when the caller is already inside one of
                           their own projects; collapsed everywhere else by default. *@
                        <details class="fo-sidebar__nav-group" data-inside-project="@(insideProjectId is not null ? "true" : "false")" open="@(insideProjectId is not null)">
                            <summary aria-expanded="@(insideProjectId is not null ? "true" : "false")" aria-current="@(insideProjectId is not null ? "page" : null)">
                                @Html.Raw(Icons.Project)
                                <span>Projects</span>
                            </summary>
                            <div class="fo-sidebar__nav-sub">
                                @foreach (var project in sidebarProjects)
                                {
                                    <a asp-page="/Projects/Details" asp-route-id="@project.ProjectId"
                                       aria-current="@(insideProjectId == project.ProjectId ? "page" : null)"
                                       title="@project.Name">
                                        @project.Name
                                    </a>
                                }
                                @* The escape hatch back to browsing/administering every project
                                   (Phase 29D §3/§20) — always present, so "Projects" never has to
                                   double as both a toggle and a direct link. *@
                                <a class="fo-sidebar__nav-sub-all" asp-page="/Projects/Index" aria-current="@(current == "/Projects/Index" ? "page" : null)">
                                    View all projects
                                </a>
                            </div>
                        </details>
                        @* ADR-0036: Team Workload — shown to every organization member, same as
                           the rest of the "Work" group; the page itself narrows what each role sees
                           (Agent gets their own workload only, no team table) via the existing Team
                           Analytics scope, never via hiding this link. *@
                        <a asp-page="/TeamWorkload/Index" aria-current="@(current == "/TeamWorkload/Index" ? "page" : null)">
                            @Html.Raw(Icons.DataKpi)
                            <span>Team Workload</span>
                        </a>
                        @* Guide: a global product resource, not tenant/role administration, so it
                           sits with Work rather than under the Administration group or Settings
                           (reached via the identity block below, not this nav list). *@
                        <div class="fo-sidebar__guide-anchor">
                            <a asp-page="/Guide/Index" aria-current="@(current.StartsWith("/Guide", StringComparison.Ordinal) ? "page" : null)">
                                @Html.Raw(Icons.Guide)
                                <span>Guide</span>
                            </a>
                            @* First-time discovery cue (verification-pass follow-on feature): rendered
                               inline, in the sidebar's own normal flow — never an absolutely-positioned
                               floating popover — so it can never overflow the viewport at any width,
                               including 390/430px, and needs no JavaScript to position itself. Shown
                               exactly once, ever, per user: IndexModel.OnGetAsync already consumed the
                               one-shot flag server-side by the time this renders, so simply navigating
                               away (without clicking anything below) is itself a valid, permanent dismissal. *@
                            @if (ViewData["ShowGuideCue"] is true)
                            {
                                <div class="fo-guide-cue" role="status">
                                    <p class="fo-guide-cue__title">New to FlowOps?</p>
                                    <p class="fo-guide-cue__body">Start with the Guide to learn how everything works.</p>
                                    <div class="fo-guide-cue__actions">
                                        <a class="fo-guide-cue__open" asp-page="/Guide/Index">Open Guide &rarr;</a>
                                        <label class="fo-guide-cue__dismiss" for="fo-guide-cue-dismiss">Dismiss</label>
                                    </div>
                                    <input type="checkbox" id="fo-guide-cue-dismiss" class="fo-guide-cue__dismiss-input" />
                                </div>
                            }
                        </div>
                    }
                    @* Phase F1-B: one shared eyebrow label for the Members/Admin/Platform group —
                       only rendered when at least one of them will actually show below it. *@
                    @if (showAdministrationGroup)
                    {
                        <p class="fo-sidebar__nav-label">Administration</p>
                    }
                    @* Phase 18: member management is Admin/Manager-only (ORG-RULE-11) — hidden for
                       everyone else as an affordance; Members.cshtml.cs re-checks server-side
                       regardless of whether this link is shown. *@
                    @if (currentUser is not null && FlowOps.Domain.Organizations.OrganizationAccessPolicy.CanManageMembers(currentUser))
                    {
                        <a asp-page="/Organization/Members" aria-current="@(current == "/Organization/Members" ? "page" : null)">
                            @Html.Raw(Icons.Members)
                            <span>Members</span>
                        </a>
                    }
                    @* Team/category/project administration is Admin-only (CLAUDE.md §6.1) — the
                       same DirectoryAccessPolicy gate /Admin/Index.cshtml.cs itself already
                       enforces server-side, so this link is purely an affordance. *@
                    @if (currentUser is not null && FlowOps.Domain.Directory.DirectoryAccessPolicy.CanManageTeams(currentUser))
                    {
                        <a asp-page="/Admin/Index" aria-current="@(current.StartsWith("/Admin", StringComparison.Ordinal) ? "page" : null)">
                            @Html.Raw(Icons.Admin)
                            <span>Admin</span>
                        </a>
                    }
                    @* Phase 24 (ADR-0023): shown only to a Platform Admin — a pure affordance,
                       exactly like every other conditional link here; every /Platform page
                       independently re-checks PlatformUserAccessor server-side regardless of
                       whether this link is shown. Never gated on OrganizationMembership. *@
                    @if (platformAdmin is not null)
                    {
                        <a asp-page="/Platform/Index" aria-current="@(current == "/Platform/Index" ? "page" : null)">
                            @Html.Raw(Icons.Platform)
                            <span>Platform</span>
                        </a>
                        @* Phase 24B: direct links to Organizations/Users — the homepage itself now
                           surfaces both already, but a Platform Admin working inside one area for a
                           while still benefits from a direct route back into it, the same way the
                           tenant sidebar lists Work Queue/At-Risk separately rather than only via
                           the dashboard. *@
                        <a asp-page="/Platform/Organizations/Index" aria-current="@(current.StartsWith("/Platform/Organizations", StringComparison.Ordinal) ? "page" : null)">
                            @Html.Raw(Icons.DataKpi)
                            <span>Organizations</span>
                        </a>
                        <a asp-page="/Platform/Users/Index" aria-current="@(current.StartsWith("/Platform/Users", StringComparison.Ordinal) ? "page" : null)">
                            @Html.Raw(Icons.Members)
                            <span>Users</span>
                        </a>
                        @* Phase 30D (ADR-0034): the one shared SLA table every organization's
                           tickets resolve against (ADR-0015: deliberately global) — a Platform,
                           not tenant, concern. *@
                        <a asp-page="/Platform/Sla/Index" aria-current="@(current.StartsWith("/Platform/Sla", StringComparison.Ordinal) ? "page" : null)">
                            @Html.Raw(Icons.Sla)
                            <span>SLA Configuration</span>
                        </a>
                    }
                </nav>

                <div class="fo-sidebar__spacer"></div>

                @* Phase 11: the top bar was removed entirely (it duplicated Profile/Sign out
                   below and was ~75% empty on every page) — the identity block now renders once,
                   here, on both desktop and the mobile off-canvas panel. *@
                <div class="fo-sidebar__identity">
                    @await Html.PartialAsync("_IdentityBlock", identity)
                </div>

                @* Step 3 (Platform Administration cleanup): the identity block above is now
                   itself the link to Profile & Settings, so only Sign out remains here — never
                   competing with primary navigation for attention. Preserved exactly: existing
                   tests source a genuine antiforgery token from "/" via this form, and
                   Login/logout behavior must not change (CLAUDE.md §12). *@
                <div class="fo-sidebar__footer">
                    <form method="post" asp-page="/Account/Logout" class="fo-sidebar__signout">
                        <button type="submit">
                            @Html.Raw(Icons.SignOut)
                            <span>Sign out</span>
                        </button>
                    </form>
                </div>
            </aside>

            <div class="fo-appmain">
                <main id="main">
                    @RenderBody()
                </main>
            </div>
        </div>
        @* Phase 29D: only needed alongside the Projects nav group above, so it is loaded only on
           the authenticated branch — never on the anonymous Login/Register/etc. pages, which have
           no sidebar at all. Progressive enhancement only; see the file's own doc comment. *@
        <script src="~/js/sidebar-projects.js" asp-append-version="true"></script>
    }
    else
    {
        <main id="main">
            @RenderBody()
        </main>
    }
    @* ADR-0028: the one JS-required UI enhancement on the site — themed dropdowns. Loaded
       unconditionally (every page, both branches above) since selects appear throughout the app;
       every select still works as a plain native control if this never runs. *@
    <script src="~/js/custom-select.js" asp-append-version="true"></script>
    <script src="~/js/row-menu.js" asp-append-version="true"></script>
</body>
</html>
