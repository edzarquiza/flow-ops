@page
@{
    ViewData["Title"] = "Guide";
}
<div class="page-header">
    <div class="section-head section-head--plain">
        <h1>Understand how FlowOps works</h1>
        <p class="page-context">A quick guide to managing work, monitoring attention, and coordinating operational delivery.</p>
    </div>
</div>

<div class="guide-card-grid">
    <a class="guide-card" asp-page="/Guide/GettingStarted">
        <h2 class="guide-card__title">Getting Started</h2>
        <p class="guide-card__body">A quick introduction to the FlowOps workflow.</p>
        <span class="guide-card__arrow">Read &rarr;</span>
    </a>
    <a class="guide-card" asp-page="/Guide/CoreConcepts">
        <h2 class="guide-card__title">Core Concepts</h2>
        <p class="guide-card__body">Organizations, teams, work, priorities and SLAs.</p>
        <span class="guide-card__arrow">Read &rarr;</span>
    </a>
    <a class="guide-card" asp-page="/Guide/WorkingWithWork">
        <h2 class="guide-card__title">Working with Work</h2>
        <p class="guide-card__body">Create, assign, update and resolve operational work.</p>
        <span class="guide-card__arrow">Read &rarr;</span>
    </a>
    <a class="guide-card" asp-page="/Guide/SlaAndAttention">
        <h2 class="guide-card__title">SLA &amp; Attention</h2>
        <p class="guide-card__body">Understand deadlines and why work needs attention.</p>
        <span class="guide-card__arrow">Read &rarr;</span>
    </a>
    <a class="guide-card" asp-page="/Guide/ProjectsAndSprints">
        <h2 class="guide-card__title">Projects &amp; Sprints</h2>
        <p class="guide-card__body">Plan and organize delivery work.</p>
        <span class="guide-card__arrow">Read &rarr;</span>
    </a>
    <a class="guide-card" asp-page="/Guide/TeamsAndWorkload">
        <h2 class="guide-card__title">Teams &amp; Workload</h2>
        <p class="guide-card__body">Understand ownership and team workload.</p>
        <span class="guide-card__arrow">Read &rarr;</span>
    </a>
    <a class="guide-card" asp-page="/Guide/RolesAndPermissions">
        <h2 class="guide-card__title">Roles &amp; Permissions</h2>
        <p class="guide-card__body">Understand what each role can access.</p>
        <span class="guide-card__arrow">Read &rarr;</span>
    </a>
</div>
